{
  "name": "erp-crm-backend",
  "version": "1.0.0",
  "description": "Backend Serverless en Google Cloud / Firebase para ERP-CRM",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:erp-crm",
    "migrate": "npx tsx src/migration/importLegacySql.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.7",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
